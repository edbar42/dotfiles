#!/usr/bin/env bash
set -euo pipefail

# Find default sink name reliably
default_sink() {
  pactl info | awk -F': ' '/Default Sink/{print $2}'
}

bump() {
  local delta="$1"
  local sink
  sink=$(default_sink)
  if [[ "$delta" == "+"* ]]; then
    pactl set-sink-volume "$sink" "+1%"
  else
    pactl set-sink-volume "$sink" "-1%"
  fi
}

usage() {
  echo "Usage: $0 {inc|dec|mute}"
}

cmd="${1:-}"

case "$cmd" in
  inc)
    bump "+1%"
    ;;
  dec)
    bump "-1%"
    ;;
  mute)
    pactl set-sink-mute "$(default_sink)" toggle
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
