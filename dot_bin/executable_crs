#!/usr/bin/env bash
set -euo pipefail

# Pick a past Claude Code conversation with fzf and resume it.
#
# Sessions live in ~/.claude/projects/<slugified-cwd>/<session-id>.jsonl
# Flags:
#   -c    only sessions whose cwd is inside the current directory
#   -n N  limit to the N most recent sessions
#   -h    help
# Anything after -- is forwarded to claude (e.g. -- --fork-session).

projects_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"

# jq helpers shared by the listing and the preview.
read -r -d '' JQ_DEFS <<'JQ' || true
def txt:
  if . == null then ""
  elif type == "string" then .
  else ([.[]? | select(.type? == "text") | .text] | join("\n"))
  end;
def clean:
  gsub("(?s)<system-reminder>.*?</system-reminder>"; "")
  | gsub("(?s)<local-command-stdout>.*?</local-command-stdout>"; "");
def realuser:
  select(.type == "user" and .isSidechain != true and .isMeta != true);
JQ

# ---------------------------------------------------------------- preview ----
if [[ "${1:-}" == "--preview" ]]; then
  file="$2"
  printf '\033[1;34m%s\033[0m\n\n' "$(basename "$file" .jsonl)"
  jq -r "$JQ_DEFS"'
    select(.type == "user" or .type == "assistant")
    | select(.isSidechain != true and .isMeta != true)
    | (.message.content | txt | clean) as $t
    | select($t | test("^\\s*$") | not)
    | select($t | startswith("<") | not)
    | if .type == "user"
      then "[1;32m▸ user[0m\n" + ($t[0:1200])
      else "[1;33m◂ claude[0m\n" + ($t[0:800])
      end
    | . + "\n"
  ' "$file" 2>/dev/null
  exit 0
fi

# ------------------------------------------------------------------ flags ----
scope_here=0
limit=0
while getopts ":cn:h" opt; do
  case "$opt" in
    c) scope_here=1 ;;
    n) limit="$OPTARG" ;;
    h)
      sed -n '3,11p' "$0" | sed 's/^# \?//'
      exit 0
      ;;
    *)
      echo "usage: $(basename "$0") [-c] [-n N] [-- claude args...]" >&2
      exit 1
      ;;
  esac
done
shift $((OPTIND - 1))

[[ -d "$projects_dir" ]] || { echo "no sessions dir at $projects_dir" >&2; exit 1; }
command -v fzf >/dev/null || { echo "fzf is required" >&2; exit 1; }
command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }

# ---------------------------------------------------------------- listing ----
here="$PWD"

rows=""
while IFS= read -r file; do
  [[ -s "$file" ]] || continue

  # cwd, branch and first human prompt all live near the top of the file.
  meta=$(head -n 400 "$file" | jq -rs "$JQ_DEFS"'
    (map(select(.cwd)) | .[0].cwd // "?") as $cwd
    | (map(select(.gitBranch // "" != "")) | .[0].gitBranch // "-") as $branch
    | ([ .[] | realuser | .message.content | txt | clean ]
       | map(select(test("^\\s*$") | not))
       | map(select(startswith("<") | not))
       | map(select(startswith("Caveat:") | not))
       | .[0] // "(no prompt)") as $first
    | [$cwd, $branch, ($first | gsub("\\s+"; " ") | .[0:200])] | @tsv
  ' 2>/dev/null) || continue
  [[ -n "$meta" ]] || continue

  IFS=$'\t' read -r cwd branch first <<<"$meta"

  if (( scope_here )); then
    [[ "$cwd" == "$here" || "$cwd" == "$here"/* ]] || continue
  fi

  turns=$(grep -c '"type":"assistant"' "$file" || true)
  when=$(date -d "@$(stat -c %Y "$file")" '+%Y-%m-%d %H:%M')
  short_cwd="${cwd/#$HOME/\~}"
  (( ${#short_cwd} > 28 )) && short_cwd="…${short_cwd: -27}"

  rows+=$(printf '%s\t%s\t\033[36m%s\033[0m  \033[35m%-28s\033[0m \033[2m%-18s %4s turns\033[0m  %s' \
    "$file" "$cwd" "$when" "$short_cwd" "${branch:0:18}" "$turns" "$first")
  rows+=$'\n'
done < <(find "$projects_dir" -name '*.jsonl' -not -path '*/subagents/*' -printf '%T@ %p\n' \
           | sort -rn \
           | { [[ "$limit" -gt 0 ]] && head -n "$limit" || cat; } \
           | cut -d' ' -f2-)

[[ -n "$rows" ]] || { echo "no matching sessions" >&2; exit 1; }

selected=$(printf '%s' "$rows" | fzf \
  --ansi \
  --delimiter=$'\t' \
  --with-nth=3.. \
  --no-sort \
  --height=100% \
  --border \
  --prompt='claude session > ' \
  --header='enter: resume   ctrl-/: toggle preview' \
  --preview="$(printf '%q' "$(realpath "$0")") --preview {1}" \
  --preview-window='right:55%:wrap' \
  --bind='ctrl-/:toggle-preview') || exit 0

file="${selected%%$'\t'*}"
rest="${selected#*$'\t'}"
cwd="${rest%%$'\t'*}"
session_id="$(basename "$file" .jsonl)"

if [[ -d "$cwd" ]]; then
  cd "$cwd"
else
  echo "warning: original cwd '$cwd' is gone, resuming from $PWD" >&2
fi

exec claude --resume "$session_id" "$@"
