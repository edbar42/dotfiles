{
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true,
    "caveman@caveman": true
  },
  "tui": "fullscreen",
  "skipAutoPermissionPrompt": true
}
